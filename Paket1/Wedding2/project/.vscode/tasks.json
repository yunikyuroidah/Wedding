{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "dev",
            "label": "npm: dev",
            "group": "build",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Local:.*$",
                    "endsPattern": "^.*ready in.*$"
                }
            }
        },
        {
            "type": "npm",
            "script": "build",
            "label": "npm: build",
            "group": "build"
        },
        {
            "type": "npm",
            "script": "preview",
            "label": "npm: preview",
            "group": "build",
            "isBackground": true,
            "dependsOn": "npm: build"
        }
    ]
}